{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"mount_file_id":"1UwUwBcw03TuXJZHk90S5bguwCqyz9drh","authorship_tag":"ABX9TyPkZQOTCgLV9RS8Pg/pJAOx"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["**Sensitivitas Konstruksi terhadap TPK — Provinsi DIY**\n","\n","Model : Laju Konstruksi Hotel = Investasi x s x MAX(0, TPK - TPK Ambang)\n","\n","- Laju Demolisi Hotel   = Jumlah Hotel x Laju Demolisi Dasar\n","- Metode: identitas stock-flow 2015-2025\n","- s = Sum Konstruksi / Sum[Investasi x MAX(0, TPK - Ambang)]\n","- Sum Konstruksi = Sum dHotel + Laju Demolisi x Sum Hotel(t-1)"],"metadata":{"id":"bL0scHMI2bA4"}},{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1pV3n8LJ1z0h","executionInfo":{"status":"ok","timestamp":1789627313957,"user_tz":-420,"elapsed":6406,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"d0cb2f29-c269-4319-aa27-415e3731fb05"},"outputs":[{"output_type":"stream","name":"stdout","text":["Data berhasil dibaca.\n"]}],"source":["import numpy as np\n","import openpyxl\n","from pathlib import Path\n","\n","FILE_MASTER = \"/content/drive/MyDrive/Skripsi_Citra/Parameter Hotel/[FIX] Master Data.xlsx\"\n","SHEET = \"Data Tahunan\"\n","TAHUN = list(range(2015, 2026))\n","LAJU_DEMOLISI = 0.05\n","TPK_AMBANG = 0.275\n","\n","if not Path(FILE_MASTER).exists():\n","    from google.colab import files\n","    print(f\"'{FILE_MASTER}' belum ada, silakan upload:\")\n","    files.upload()\n","\n","BARIS = {\n","    \"hotel\": \"Jumlah Hotel dan Akomodasi Lainnya\",\n","    \"tpk\": \"Tingkat Penghunian Kamar (TPK)\",      # persen\n","    \"investasi\": \"Investasi Sektor Pariwisata\",\n","}\n","\n","ws = openpyxl.load_workbook(FILE_MASTER, data_only=True)[SHEET]\n","kolom = {}\n","for c in range(1, ws.max_column + 1):\n","    v = str(ws.cell(1, c).value).strip()\n","    if v.isdigit():\n","        kolom[int(v)] = c\n","\n","d = {}\n","for kunci, nama in BARIS.items():\n","    baris = None\n","    for r in range(1, ws.max_row + 1):\n","        if str(ws.cell(r, 2).value).strip() == nama:\n","            baris = r\n","            break\n","    if baris is None:\n","        raise ValueError(f\"Baris '{nama}' tidak ditemukan\")\n","    d[kunci] = np.array([float(ws.cell(baris, kolom[t]).value) for t in TAHUN])\n","\n","d[\"tpk\"] = d[\"tpk\"] / 100\n","print(\"Data berhasil dibaca.\")"]},{"cell_type":"markdown","source":["1. Perhitungan Sensitivitas Konstruksi"],"metadata":{"id":"7gdj0MOGF5fU"}},{"cell_type":"code","source":["hotel, tpk, inv = d[\"hotel\"], d[\"tpk\"], d[\"investasi\"]\n","\n","konstruksi = np.diff(hotel) + LAJU_DEMOLISI * hotel[:-1]         # 2016..2025\n","selisih = np.maximum(0, tpk[1:] - TPK_AMBANG)\n","pendorong = inv[1:] * selisih\n","s = konstruksi.sum() / pendorong.sum()\n","\n","print(\"=== SENSITIVITAS KONSTRUKSI TERHADAP TPK ===\")\n","print(f\"Sum dHotel 2016-2025          = {hotel[-1] - hotel[0]:.0f} unit\")\n","print(f\"Demolisi x Sum Hotel 2015-2024 = {LAJU_DEMOLISI} x {hotel[:-1].sum():.0f} = {LAJU_DEMOLISI * hotel[:-1].sum():.1f} unit\")\n","print(f\"Sum Konstruksi                 = {konstruksi.sum():.1f} unit\")\n","print(f\"Sum[Investasi x MAX(0,TPK-Ambang)] = {pendorong.sum():.2f}\")\n","print(f\"\\nSensitivitas = {konstruksi.sum():.1f} / {pendorong.sum():.2f} = {s:.4f}\")\n","\n","print(f\"\\n{'Tahun':>5} {'Konstr.data':>11} {'Investasi':>10} {'TPK-Ambang':>11} {'Konstr.rumus':>12}\")\n","for t, c, i, g, x in zip(TAHUN[1:], konstruksi, inv[1:], selisih, pendorong):\n","    print(f\"{t:>5} {c:>11.1f} {i:>10.1f} {g:>11.3f} {s * x:>12.1f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7Cmxnu1BGE62","executionInfo":{"status":"ok","timestamp":1789627335453,"user_tz":-420,"elapsed":11,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"cae55260-2f27-4059-ea56-3b431d29185c"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["=== SENSITIVITAS KONSTRUKSI TERHADAP TPK ===\n","Sum dHotel 2016-2025          = 1126 unit\n","Demolisi x Sum Hotel 2015-2024 = 0.05 x 16130 = 806.5 unit\n","Sum Konstruksi                 = 1932.5 unit\n","Sum[Investasi x MAX(0,TPK-Ambang)] = 835.19\n","\n","Sensitivitas = 1932.5 / 835.19 = 2.3138\n","\n","Tahun Konstr.data  Investasi  TPK-Ambang Konstr.rumus\n"," 2016        63.2      373.8       0.102         88.4\n"," 2017        67.5      165.4       0.176         67.3\n"," 2018       496.9      568.3       0.176        231.6\n"," 2019       280.9      741.4       0.178        306.1\n"," 2020       121.9      489.7       0.014         15.9\n"," 2021       -59.6      848.8       0.000          0.0\n"," 2022       206.8      463.6       0.175        187.6\n"," 2023        92.9     1175.3       0.173        469.6\n"," 2024       271.0      712.3       0.147        241.8\n"," 2025       391.0     1326.0       0.106        324.3\n"]}]},{"cell_type":"markdown","source":["2. Tabel uji sensitivitas (s dihitung ulang berpasangan)"],"metadata":{"id":"V9uzEUglGkkR"}},{"cell_type":"code","source":["print(\"=== s UNTUK KOMBINASI DEMOLISI & AMBANG ===\")\n","print(f\"{'Demolisi':>9} {'Ambang':>7} {'Sensitivitas':>12}\")\n","for dd in (0.02, 0.05, 0.08):\n","    for aa in (0.20, 0.275, 0.35):\n","        cc = np.diff(hotel) + dd * hotel[:-1]\n","        xx = inv[1:] * np.maximum(0, tpk[1:] - aa)\n","        print(f\"{dd:>9.2f} {aa:>7.3f} {cc.sum() / xx.sum():>12.3f}\")\n","\n","print(\"\\nRumus Excel (Data Tahunan O43):\")\n","print(\"=((O5-E5)+O45*SUM(E5:N5))/SUMPRODUCT(F34:O34,(F33:O33/100-O44)*(F33:O33/100>O44))\")"],"metadata":{"id":"eVdZY9d7GljS","executionInfo":{"status":"ok","timestamp":1789627367447,"user_tz":-420,"elapsed":15,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"c1073418-dbd5-40c9-b853-4285932fe5c1","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["=== s UNTUK KOMBINASI DEMOLISI & AMBANG ===\n"," Demolisi  Ambang Sensitivitas\n","     0.02   0.200        1.073\n","     0.02   0.275        1.734\n","     0.02   0.350        3.500\n","     0.05   0.200        1.432\n","     0.05   0.275        2.314\n","     0.05   0.350        4.669\n","     0.08   0.200        1.790\n","     0.08   0.275        2.893\n","     0.08   0.350        5.838\n","\n","Rumus Excel (Data Tahunan O43):\n","=((O5-E5)+O45*SUM(E5:N5))/SUMPRODUCT(F34:O34,(F33:O33/100-O44)*(F33:O33/100>O44))\n"]}]}]}