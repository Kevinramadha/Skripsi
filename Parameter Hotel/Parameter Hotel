{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"mount_file_id":"11seHnhPo6iSGXIcdnsYyoTOXtMWk9Y2u","authorship_tag":"ABX9TyMgOdB/F/cPepisxB7iExoT"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["**Parameter Sektor Hotel — Provinsi DIY**\n","\n","1. Malam Tersedia per Kamar (malam operasional efektif)  [Malam/Kamar]\n","2. TPK Ambang: bukti batas dari data 2020-2021 + uji kecocokan ambang 0-0,45\n","\n","Struktur model:\n","  \n","  - TPK = (Malam Tamu / TPG) / (Jumlah Hotel x Kamar per Unit x Malam Tersedia per Kamar)\n","  - Laju Konstruksi Hotel = Investasi x Sensitivitas Konstruksi x MAX(0, TPK - TPK Ambang)\n","  - Laju Demolisi Hotel   = Jumlah Hotel x Laju Demolisi Dasar\n","\n","Cara pakai:\n","    pip install openpyxl numpy --break-system-packages\n","    python hitung_parameter_hotel.py"],"metadata":{"id":"vsvN6qH-qZ6s"}},{"cell_type":"code","execution_count":15,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ACWYP0tOqBPd","executionInfo":{"status":"ok","timestamp":1789620780790,"user_tz":-420,"elapsed":2056,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"aa48ae4d-3bba-4f9b-d4d1-a1f47f743465"},"outputs":[{"output_type":"stream","name":"stdout","text":["Data berhasil dibaca.\n"]}],"source":["import numpy as np\n","import openpyxl\n","from pathlib import Path\n","\n","FILE_MASTER = \"/content/drive/MyDrive/Skripsi_Citra/Parameter Hotel/[FIX] Master Data.xlsx\"\n","SHEET = \"Data Tahunan\"\n","TAHUN = list(range(2015, 2026))\n","LAJU_DEMOLISI = 0.05\n","\n","BARIS = {\n","    \"hotel\": \"Jumlah Hotel dan Akomodasi Lainnya\",\n","    \"tpk\": \"Tingkat Penghunian Kamar (TPK)\",      # dalam persen\n","    \"malam\": \"Total Malam Menginap\",\n","    \"tpg\": \"Tingkat Penghunian Ganda Kamar\",\n","    \"kamar\": \"Jumlah Kamar\",\n","    \"investasi\": \"Investasi Sektor Pariwisata\",\n","}\n","\n","ws = openpyxl.load_workbook(FILE_MASTER, data_only=True)[SHEET]\n","\n","kolom = {}\n","for c in range(1, ws.max_column + 1):\n","    v = str(ws.cell(1, c).value).strip()\n","    if v.isdigit():\n","        kolom[int(v)] = c\n","\n","d = {}\n","for kunci, nama in BARIS.items():\n","    baris_ditemukan = None\n","    for r in range(1, ws.max_row + 1):\n","        if str(ws.cell(r, 2).value).strip() == nama:\n","            baris_ditemukan = r\n","            break\n","    if baris_ditemukan is None:\n","        raise ValueError(f\"Baris '{nama}' tidak ditemukan di sheet {SHEET}\")\n","    d[kunci] = np.array([float(ws.cell(baris_ditemukan, kolom[t]).value) for t in TAHUN])\n","\n","d[\"tpk\"] = d[\"tpk\"] / 100   # persen -> pecahan\n","kamar_terpakai = d[\"malam\"] / d[\"tpg\"]\n","print(\"Data berhasil dibaca.\")"]},{"cell_type":"markdown","source":["1. Malam Kamar Tersedia"],"metadata":{"id":"mn4lO1qsrB0R"}},{"cell_type":"code","source":["print(\"=== 1. MALAM TERSEDIA PER KAMAR ===\")\n","tersirat = kamar_terpakai / (d[\"tpk\"] * d[\"kamar\"])\n","for t, v in zip(TAHUN, tersirat):\n","    tanda = \"  <-- > 365, data tidak konsisten\" if v > 365 else \"\"\n","    print(f\"{t}: {v:6.1f} malam{tanda}\")\n","\n","malam_efektif = kamar_terpakai.sum() / (d[\"tpk\"] * d[\"kamar\"]).sum()\n","print(f\"\\nMalam Tersedia per Kamar = {malam_efektif:.2f}\")\n","\n","tpk_model = kamar_terpakai / (d[\"kamar\"] * malam_efektif)\n","print(f\"\\n{'Tahun':>5} {'TPK BPS':>8} {'TPK model':>10}\")\n","for t, a, b in zip(TAHUN, d[\"tpk\"], tpk_model):\n","    print(f\"{t:>5} {a:>8.3f} {b:>10.3f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bEzo6P5jrA-L","executionInfo":{"status":"ok","timestamp":1789620802257,"user_tz":-420,"elapsed":8,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"1ef80fa4-0a56-4057-d0a2-7257f06d8593"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["=== 1. MALAM TERSEDIA PER KAMAR ===\n","2015:  366.9 malam  <-- > 365, data tidak konsisten\n","2016:  324.4 malam\n","2017:  483.8 malam  <-- > 365, data tidak konsisten\n","2018:  359.7 malam\n","2019:  408.5 malam  <-- > 365, data tidak konsisten\n","2020:  219.9 malam\n","2021:  363.2 malam\n","2022:  270.3 malam\n","2023:  329.3 malam\n","2024:  253.5 malam\n","2025:  309.2 malam\n","\n","Malam Tersedia per Kamar = 329.03\n","\n","Tahun  TPK BPS  TPK model\n"," 2015    0.349      0.389\n"," 2016    0.377      0.372\n"," 2017    0.451      0.663\n"," 2018    0.451      0.493\n"," 2019    0.453      0.563\n"," 2020    0.289      0.193\n"," 2021    0.275      0.303\n"," 2022    0.450      0.370\n"," 2023    0.448      0.448\n"," 2024    0.422      0.325\n"," 2025    0.381      0.358\n"]}]},{"cell_type":"markdown","source":["2. TPK AMBANG: BATAS DARI DATA 2020-2021"],"metadata":{"id":"lTqOXBDwrKXo"}},{"cell_type":"code","source":["print(\"=== 2. TPK AMBANG: BATAS DARI DATA 2020-2021 ===\")\n","konstruksi = np.diff(d[\"hotel\"]) + LAJU_DEMOLISI * d[\"hotel\"][:-1]   # 2016..2025\n","\n","for t in (2020, 2021):\n","    i = TAHUN.index(t)\n","    print(f\"{t}: TPK BPS = {d['tpk'][i]:.3f}, konstruksi tersirat = {konstruksi[i - 1]:.1f} unit\")\n","\n","print(\"-> konstruksi masih positif pada TPK 2020, praktis nol/negatif pada TPK 2021\")\n","print(f\"-> TPK Ambang berada di antara {d['tpk'][TAHUN.index(2021)]:.3f} \"\n","      f\"dan {d['tpk'][TAHUN.index(2020)]:.3f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"FPjYtpXNrP7i","executionInfo":{"status":"ok","timestamp":1789620827371,"user_tz":-420,"elapsed":11,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"f28300f8-d5d2-4fee-8c6c-4c552d244c29"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["=== 2. TPK AMBANG: BATAS DARI DATA 2020-2021 ===\n","2020: TPK BPS = 0.289, konstruksi tersirat = 121.9 unit\n","2021: TPK BPS = 0.275, konstruksi tersirat = -59.6 unit\n","-> konstruksi masih positif pada TPK 2020, praktis nol/negatif pada TPK 2021\n","-> TPK Ambang berada di antara 0.275 dan 0.289\n"]}]},{"cell_type":"markdown","source":["3. Uji kecocokan ambang 0 - 0,45"],"metadata":{"id":"7WxiPAUityqk"}},{"cell_type":"code","source":["print(f\"=== 3. UJI KECOCOKAN AMBANG (TPK BPS, demolisi = {LAJU_DEMOLISI}) ===\")\n","print(f\"{'Ambang':>7} {'Sensitivitas':>12} {'SSE':>10} {'Korelasi':>9} {'Tahun nol':>9}\")\n","\n","inv = d[\"investasi\"][1:]\n","tpk = d[\"tpk\"][1:]\n","\n","for A in np.arange(0.0, 0.4501, 0.025):\n","    X = inv * np.maximum(0, tpk - A)\n","    if X.sum() == 0:\n","        continue\n","    s = konstruksi.sum() / X.sum()\n","    sse = ((konstruksi - s * X) ** 2).sum()\n","    r = np.corrcoef(konstruksi, X)[0, 1]\n","    print(f\"{A:>7.3f} {s:>12.3f} {sse:>10.0f} {r:>9.3f} {(X == 0).sum():>9d}\")\n","\n","print(\"\\nRumus Excel:\")\n","print(\"Malam Tersedia per Kamar (O66): =SUMPRODUCT(E29:O29/E61:O61)/SUMPRODUCT(E33:O33/100*E64:O64)\")\n","print(\"TPK Ambang (O44)              : 0.275\")"],"metadata":{"id":"vSG7eDYzt1Qx","executionInfo":{"status":"ok","timestamp":1789620879720,"user_tz":-420,"elapsed":44,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"e20f57a5-9d1d-4b97-8894-e596a505515c","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["=== 3. UJI KECOCOKAN AMBANG (TPK BPS, demolisi = 0.05) ===\n"," Ambang Sensitivitas        SSE  Korelasi Tahun nol\n","  0.000        0.710     240294     0.367         0\n","  0.025        0.757     238525     0.374         0\n","  0.050        0.812     236619     0.382         0\n","  0.075        0.875     234576     0.391         0\n","  0.100        0.949     232404     0.401         0\n","  0.125        1.036     230131     0.412         0\n","  0.150        1.141     227829     0.424         0