\f0\fs24 \cf0 // ============================================================\
// LUAS TERBANGUN DYNAMIC WORLD \'97 TANPA PENYARINGAN OBSERVASI\
// DIY 2016-2025, jendela setahun penuh\
// ============================================================\
\
var gaul = ee.FeatureCollection("FAO/GAUL/2015/level1");\
var diy = gaul.filter(ee.Filter.and(\
  ee.Filter.eq('ADM0_NAME', 'Indonesia'),\
  ee.Filter.eq('ADM1_NAME', 'Daerah Istimewa Yogyakarta')\
));\
Map.centerObject(diy, 9);\
\
var dw = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1").filterBounds(diy);\
var KELAS_BUILT = 6;\
\
var OPSI = \{\
  reducer: ee.Reducer.sum(),\
  geometry: diy.geometry(),\
  scale: 10,\
  maxPixels: 1e13,\
  tileScale: 8\
\};\
\
function tahunan(th) \{\
  th = ee.Number(th);\
  var sub = dw.filterDate(ee.Date.fromYMD(th, 1, 1),\
                          ee.Date.fromYMD(th, 12, 31));\
\
  // TIDAK ada masking observasi minimum\
  var nObs = sub.select('label').count().rename('n_obs').clip(diy);\
  var adaData = nObs.gte(1);\
\
  // metode A: modus label\
  var builtModus = sub.select('label').mode().clip(diy)\
                      .eq(KELAS_BUILT).unmask(0);\
\
  // metode B: rata-rata probabilitas built, ambang 0,5\
  var probMean = sub.select('built').mean().clip(diy);\
  var builtProb = probMean.gte(0.5).unmask(0);\
\
  // metode C: jumlah probabilitas (luas terbangun "lunak")\
  var luasLunak = probMean.unmask(0)\
                    .multiply(ee.Image.pixelArea()).divide(10000)\
                    .reduceRegion(OPSI);\
\
  var luasModus = builtModus.multiply(ee.Image.pixelArea()).divide(10000)\
                            .reduceRegion(OPSI);\
  var luasProb = builtProb.multiply(ee.Image.pixelArea()).divide(10000)\
                          .reduceRegion(OPSI);\
  var cakupan = adaData.multiply(ee.Image.pixelArea()).divide(10000)\
                       .reduceRegion(OPSI);\
  var obsRerata = nObs.reduceRegion(\{\
    reducer: ee.Reducer.mean(), geometry: diy.geometry(),\
    scale: 100, maxPixels: 1e13, tileScale: 8\
  \});\
\
  return ee.Feature(null, \{\
    'tahun': th,\
    'n_citra': sub.size(),\
    'obs_per_piksel': obsRerata.get('n_obs'),\
    'cakupan_ha': cakupan.get('n_obs'),\
    'luas_modus_ha': luasModus.get('label'),\
    'luas_prob_ha': luasProb.get('built'),\
    'luas_lunak_ha': luasLunak.get('built')\
  \});\
\}\
\
var hasil = ee.FeatureCollection(\
  ee.List.sequence(2016, 2025).map(tahunan)\
);\
\
Export.table.toDrive(\{\
  collection: hasil,\
  description: 'DW_Terbangun_TanpaMask_DIY_2016_2025',\
  folder: 'Skripsi_Citra',\
  fileFormat: 'CSV',\
  selectors: ['tahun','n_citra','obs_per_piksel','cakupan_ha',\
              'luas_modus_ha','luas_prob_ha','luas_lunak_ha']\
\});\
\
// ============================================================\
// VALIDASI SPASIAL NTL \'97 TITIK SAMPEL DIY (TAHUN DASAR 2025)\
// ============================================================\
\
// --- 1. Batas wilayah DIY ---\
var gaul = ee.FeatureCollection("FAO/GAUL/2015/level1");\
var diy = gaul.filter(ee.Filter.and(\
  ee.Filter.eq('ADM0_NAME', 'Indonesia'),\
  ee.Filter.eq('ADM1_NAME', 'Daerah Istimewa Yogyakarta')\
));\
\
// --- 2. Titik sampel \'97 VERIFIKASI/GESER pin ini langsung di peta GEE sebelum dipakai ---\
var titik = ee.FeatureCollection([\
  ee.Feature(ee.Geometry.Point([110.3654, -7.7925]), \{nama: 'Malioboro-Keraton (wisata/perkotaan padat)'\}),\
  ee.Feature(ee.Geometry.Point([110.2070, -7.8450]), \{nama: 'Kawasan Industri Sentolo (industri)'\}),\
  ee.Feature(ee.Geometry.Point([110.3979, -7.8285]), \{nama: 'Kotagede (permukiman padat)'\}),\
  ee.Feature(ee.Geometry.Point([110.4457, -7.5980]), \{nama: 'TN Gunung Merapi (minim aktivitas)'\}),\
  ee.Feature(ee.Geometry.Point([110.5507, -8.1287]), \{nama: 'Pantai Baron, Gunungkidul (karst/minim aktivitas)'\})\
]);\
\
Map.centerObject(diy, 9);\
Map.addLayer(diy, \{color: 'red'\}, 'Batas DIY', false);\
\
// --- 3. Komposit NTL tahun dasar 2025 ---\
var ntl2025 = ee.ImageCollection("NOAA/VIIRS/DNB/MONTHLY_V1/VCMSLCFG")\
                .select('avg_rad')\
                .filterDate('2025-01-01', '2025-12-31')\
                .mean()\
                .clip(diy);\
\
// --- 4. Ekstraksi nilai NTL pada tiap titik (buffer 300 m, mengikuti skala 500 m VIIRS) ---\
var hasilTitik = ntl2025.reduceRegions(\{\
  collection: titik.map(function(f) \{ return f.buffer(300); \}),\
  reducer: ee.Reducer.mean(),\
  scale: 500,\
  tileScale: 4\
\});\
\
print('Nilai NTL pada titik sampel:', hasilTitik);\
\
// --- 5. Visualisasi untuk screenshot Gambar Y ---\
var visParams = \{min: 0, max: 5, palette: ['000000', '3b0f70', 'fca636', 'fcffa4']\};\
Map.addLayer(ntl2025, visParams, 'NTL 2025');\
Map.addLayer(titik, \{color: 'red'\}, 'Titik Sampel');\
\
// --- 6. Ekspor tabel nilai titik sampel ---\
Export.table.toDrive(\{\
  collection: hasilTitik,\
  description: 'Validasi_Spasial_NTL_DIY_2025',\
  folder: 'Skripsi_Citra',\
  fileFormat: 'CSV',\
  selectors: ['nama', 'mean']\
\});\
\
// ============================================================\
// EKSTRAKSI NIGHTTIME LIGHTS (VIIRS DNB) \'97 DIY 2015-2025\
// ============================================================\
\
// --- 1. Batas wilayah DIY ---\
var gaul = ee.FeatureCollection("FAO/GAUL/2015/level1");\
var diy = gaul.filter(ee.Filter.and(\
  ee.Filter.eq('ADM0_NAME', 'Indonesia'),\
  ee.Filter.eq('ADM1_NAME', 'Daerah Istimewa Yogyakarta')\
));\
print('Cek wilayah terpilih:', diy);\
Map.centerObject(diy, 9);\
Map.addLayer(diy, \{color: 'red'\}, 'Batas DIY');\
\
// --- 2. Koleksi NTL bulanan ---\
var ntl = ee.ImageCollection("NOAA/VIIRS/DNB/MONTHLY_V1/VCMSLCFG")\
            .select('avg_rad');\
\
// --- 3. Fungsi agregasi tahunan ---\
var tahunAwal = 2015;\
var tahunAkhir = 2025;\
var daftarTahun = ee.List.sequence(tahunAwal, tahunAkhir);\
\
var hasilNTL = ee.FeatureCollection(daftarTahun.map(function(th) \{\
  th = ee.Number(th);\
  var mulai = ee.Date.fromYMD(th, 1, 1);\
  var selesai = ee.Date.fromYMD(th, 12, 31);\
  \
  // rata-rata radiance bulanan sepanjang tahun\
  var komposit = ntl.filterDate(mulai, selesai).mean().clip(diy);\
  \
  // statistik zonal: mean dan sum radiance\
  var stat = komposit.reduceRegions(\{\
    collection: diy,\
    reducer: ee.Reducer.mean().combine(\{\
      reducer2: ee.Reducer.sum(), sharedInputs: true\
    \}),\
    scale: 500,\
    tileScale: 4\
  \}).first();\
  \
  return ee.Feature(null, \{\
    'tahun': th,\
    'ntl_mean': stat.get('mean'),\
    'ntl_sum': stat.get('sum')\
  \});\
\}));\
\
print('Hasil NTL tahunan:', hasilNTL);\
\
// --- 4. Grafik cepat ---\
print(ui.Chart.feature.byFeature(hasilNTL, 'tahun', ['ntl_mean'])\
  .setOptions(\{title: 'Rata-rata Radiance NTL DIY', \
               hAxis: \{title: 'Tahun'\}, vAxis: \{title: 'nW/cm2/sr'\}\}));\
\
// --- 5. Ekspor ke Google Drive ---\
Export.table.toDrive(\{\
  collection: hasilNTL,\
  description: 'NTL_DIY_2015_2025',\
  folder: 'Skripsi_Citra',\
  fileFormat: 'CSV',\
  selectors: ['tahun', 'ntl_mean', 'ntl_sum']\
\});\
\
// ============================================================\
// UJI AKURASI KELAS TERBANGUN DYNAMIC WORLD\
// DIY, tahun uji 2024 (observasi per piksel tertinggi kedua)\
// Sampel acak berstratifikasi untuk interpretasi manual\
// ============================================================\
\
var gaul = ee.FeatureCollection("FAO/GAUL/2015/level1");\
var diy = gaul.filter(ee.Filter.and(\
  ee.Filter.eq('ADM0_NAME','Indonesia'),\
  ee.Filter.eq('ADM1_NAME','Daerah Istimewa Yogyakarta')\
));\
\
var TAHUN_UJI = 2025;\
var N_PER_KELAS = 100;   // 100 terbangun + 100 bukan terbangun\
\
// --- peta biner sesuai metode final: rata-rata probabilitas >= 0,5 ---\
var dw = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1")\
          .filterBounds(diy)\
          .filterDate(TAHUN_UJI + '-01-01', TAHUN_UJI + '-12-31');\
\
var probBuilt = dw.select('built').mean().clip(diy);\
var biner = probBuilt.gte(0.5).rename('kelas_dw');\
\
// --- sampel acak berstratifikasi ---\
var sampel = biner.addBands(probBuilt.rename('prob')).stratifiedSample(\{\
  numPoints: N_PER_KELAS,\
  classBand: 'kelas_dw',\
  region: diy.geometry(),\
  scale: 10,\
  seed: 2024,\
  geometries: true\
\});\
\
// --- tambahkan koordinat agar mudah dibuka di Google Earth Pro ---\
var sampelKoord = sampel.map(function(f)\{\
  var c = f.geometry().coordinates();\
  return f.set(\{\
    'lon': c.get(0),\
    'lat': c.get(1),\
    'kelas_referensi': ''      // dikosongkan, diisi manual\
  \});\
\});\
\
Map.centerObject(diy, 9);\
Map.addLayer(biner.selfMask(), \{palette:['#C4281B']\}, 'Terbangun 2024');\
Map.addLayer(sampel.filter(ee.Filter.eq('kelas_dw',1)),\
             \{color:'yellow'\}, 'Sampel terbangun');\
Map.addLayer(sampel.filter(ee.Filter.eq('kelas_dw',0)),\
             \{color:'cyan'\}, 'Sampel bukan terbangun');\
\
Export.table.toDrive(\{\
  collection: sampelKoord,\
  description: 'Sampel_Uji_Akurasi_DW_' + TAHUN_UJI,\
  folder: 'Skripsi_Citra',\
  fileFormat: 'CSV',\
  selectors: ['lon','lat','kelas_dw','prob','kelas_referensi']\
\});}