s[0] - 1, 2014, -1):\n","    nilai = nilai / (1 + g)\n","    estimasi[th] = nilai\n","\n","print()\n","for th in sorted(estimasi):\n","    print(f\"  Estimasi {th}: Rp {estimasi[th]:,.0f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OHbfxDsBbyDm","executionInfo":{"status":"ok","timestamp":1789298063534,"user_tz":-420,"elapsed":3,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"1bc34947-5e39-4c1d-f73d-173acb214345"},"execution_count":30,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","==============================================================================\n","LANGKAH 4 — ESTIMASI 2015-2017 (EKSTRAPOLASI CAGR MUNDUR)\n","==============================================================================\n","  Titik observasi pertama : 2018 = Rp 1,372,512\n","  Titik observasi terakhir: 2025 = Rp 2,720,209\n","  CAGR (2018-2025, 7 tahun) = 10.27%\n","\n","  Estimasi 2015: Rp 1,023,749\n","  Estimasi 2016: Rp 1,128,845\n","  Estimasi 2017: Rp 1,244,730\n"]}]},{"cell_type":"markdown","source":["6. PENYUSUNAN SERI FINAL DAN KONVERSI KE UNIT MODEL (MILIAR RUPIAH)"],"metadata":{"id":"GpsRc3e6b2E3"}},{"cell_type":"code","source":["df[\"pengeluaran_final_rp\"] = df.apply(\n","    lambda r: estimasi[int(r.tahun)] if pd.isna(r.pengeluaran_gabungan_rp)\n","    else r.pengeluaran_gabungan_rp, axis=1\n",")\n","df[\"status\"] = np.where(\n","    df[\"pengeluaran_gabungan_rp\"].notna(), \"Observasi\", \"Estimasi CAGR\"\n",")\n","\n","# Parameter model 'Pengeluaran per Kunjungan' berunit Miliar Rupiah/Kunjungan\n","df[\"pengeluaran_final_miliar\"] = df[\"pengeluaran_final_rp\"] / 1e9\n","\n","print()\n","print(\"=\" * 78)\n","print(\"SERI FINAL — PENGELUARAN PER KUNJUNGAN GABUNGAN (WISNUS+WISMAN) DIY\")\n","print(\"=\" * 78)\n","final = df[[\"tahun\", \"pengeluaran_final_rp\", \"pengeluaran_final_miliar\", \"status\"]]\n","print(final.to_string(index=False,\n","      formatters={\"pengeluaran_f