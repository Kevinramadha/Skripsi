biner peta\n","p  = df[\"prob\"].values                 # probabilitas 'built'"],"metadata":{"id":"3sf5CSRvaNqe","executionInfo":{"status":"ok","timestamp":1789198926847,"user_tz":-420,"elapsed":6,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}}},"execution_count":20,"outputs":[]},{"cell_type":"markdown","source":["2. BOBOT SAMPEL"],"metadata":{"id":"Bt78amZ_aQIw"}},{"cell_type":"code","source":["W = {1: LUAS_TERBANGUN / LUAS_TOTAL, 0: LUAS_BUKAN / LUAS_TOTAL}\n","n_str = {k: int((yp == k).sum()) for k in (0, 1)}\n","w = np.array([W[k] / n_str[k] for k in yp])\n","w = w / w.sum() * len(y)               # dinormalkan agar total = n\n","\n","print(\"=\" * 74)\n","print(\"METRIK KELAS TAK BERIMBANG — DYNAMIC WORLD DIY 2025\")\n","print(\"=\" * 74)\n","print(f\"Jumlah titik      : {len(y)}\")\n","print(f\"Strata peta       : {n_str[1]} terbangun, {n_str[0]} bukan terbangun\")\n","print(f\"Bobot luas strata : {W[1]:.4f} terbangun, {W[0]:.4f} bukan terbangun\")\n","print(f\"Bobot per titik   : {w[yp==1][0]:.4f} (terbangun), \"\n","      f\"{w[yp==0][0]:.4f} (bukan)\")\n","print()\n","print(f\"Prevalensi terbangun pada sampel   : {y.mean()*100:.2f}%\")\n","print(f\"Prevalensi terbangun terbobot      : \"\n","      f\"{np.average(y, weights=w)*100:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7a9OEd3PaSXi","executionInfo":{"status":"ok","timestamp":1789198926850,"user_tz":-420,"elapsed":4,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"945e5cd0-a743-417c-d728-2edf927092c5"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["==========================================================================\n","METRIK KELAS TAK BERIMBANG — DYNAMIC WORLD DIY 2025\n","==========================================================================\n","Jumlah titik      : 200\n","Strata peta       : 100 terbangun, 100 bukan terbangun\n","Bobot luas strata : 0.1742 terbangun, 0.8258 bukan terbangun\n","Bobot per titik   : 0.3484 (terbangun), 1.6516 (bukan)\n","\n","Prevalensi terbangun pada sampel   : 35.50%\n","Prevalensi terbangun terbobot      : 15.63%\n"]}]},{"cell_type":"markdown","source":["3. METRIK BERBASIS PREDIKSI BINER"],"metadata":{"id":"Vgqnwd4zaWb7"}},{"cell_type":"code","source":["def metrik_biner(y, yp, w=None):\n","    \"\"\"Menghitung metrik dari matriks konfusi, dengan atau tanpa bobot.\"\"\"\n","    if w is None:\n","        w = np.ones(len(y))\n","    tp = w[(yp == 1) & (y == 1)].sum()\n","    fp = w[(yp == 1) & (y == 0)].sum()\n","    fn = w[(yp == 0) & (y == 1)].sum()\n","    tn = w[(yp == 0) & (y == 0)].sum()\n","\n","    prec = tp / (tp + fp) if tp + fp else np.nan          # User's Accuracy\n","    rec  = tp / (tp + fn) if tp + fn else np.nan          # Producer's / Recall\n","    spec = tn / (tn + fp) if tn + fp else np.nan          # Specificity\n","    npv  = tn / (tn + fn) if tn + fn else np.nan\n","    f1   = 2 * prec * rec / (prec + rec) if prec + rec else np.nan\n","    acc  = (tp + tn) / (tp + fp + fn + tn)\n","    bal  = (rec + spec) / 2                                # Balanced Accuracy\n","    # Matthews Correlation Coefficient\n","    pen  = np.sqrt((tp+fp) * (tp+fn) * (tn+fp) * (tn+fn))\n","    mcc  = ((tp*tn - fp*fn) / pen) if pen else np.nan\n","    # Youden's J\n","    j    = rec + spec - 1\n","    return dict(TP=tp, FP=fp, FN=fn, TN=tn, Accuracy=acc, Precision=prec,\n","                Recall=rec, Specificity=spec, NPV=npv, F1=f1,\n","                BalancedAcc=bal, MCC=mcc, YoudenJ=j)\n","\n","m_tak = metrik_biner(y, yp)\n","m_bob = metrik_biner(y, yp, w)\n","\n","print()\n","print(\"-\" * 74)\n","print(\"METRIK PADA AMBANG 0,5\")\n","print(\"-\" * 74)\n","print(f\"{'Metrik':<32}{'Tak terbobot':>16}{'Terbobot luas':>18}\")\n","print(\"-\" * 74)\n","urut = [(\"Accuracy / Overall Accuracy\", \"Accuracy\"),\n","        (\"Precision / User's Acc.\", \"Precision\"),\n","        (\"Recall / Producer's Acc.\", \"Recall\"),\n","        (\"Specificity\", \"Specificity\"),\n","        (\"Negative Predictive Value\", \"NPV\"),\n","        (\"F1-score\", \"F1\"),\n","        (\"Balanced Accuracy\", \"BalancedAcc\"),\n","        (\"Matthews Corr. Coef. (MCC)\", \"MCC\"),\n","        (\"Youden's J\", \"YoudenJ\")]\n","for nama, k in urut:\n","    a, b = m_tak[k], m_bob[k]\n","    sat = \"\" if k in (\"MCC\", \"YoudenJ\") else \"%\"\n","    fa = f\"{a:.4f}\" if sat == \"\" else f\"{a*100:.2f}%\"\n","    fb = f\"{b:.4f}\" if sat == \"\" else f\"{b*100:.2f}%\"\n","    print(f\"{nama:<32}{fa:>16}{fb:>18}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0-XTXGVpaWrx","executionInfo":{"status":"ok","timestamp":1789198926853,"user_tz":-420,"elapsed":3,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"ce7d6018-fbd5-469c-b338-04bf710d5ef9"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--------------------------------------------------------------------------\n","METRIK PADA AMBANG 0,5\n","--------------------------------------------------------------------------\n","Metrik                              Tak terbobot     Terbobot luas\n","--------------------------------------------------------------------------\n","Accuracy / Overall Accuracy               80.50%            89.95%\n","Precision / User's Acc.                   66.00%            66.00%\n","Recall / Producer's Acc.                  92.96%            73.58%\n","Specificity                               73.64%            92.98%\n","Negative Predictive Value                 95.00%            95.00%\n","F1-score                                  77.19%            69.58%\n","Balanced Accuracy                         83.30%            83.28%\n","Matthews Corr. Coef. (MCC)                0.6374            0.6372\n","Youden's J                                0.6660            0.6656\n"]}]},{