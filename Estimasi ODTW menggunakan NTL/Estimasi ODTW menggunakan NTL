Tarik Wisata.xlsx\"\n","\n","# NTL\n","df_ntl = pd.read_csv(file_ntl)\n","# ODTW\n","df_odtw = pd.read_excel(file_odtw)\n","\n","# Ambil data NTL\n","tahun = df_ntl[\"tahun\"].tolist()\n","ntl = df_ntl[\"ntl_mean\"].tolist()\n","\n","# Ambil data ODTW\n","# Buat dictionary tahun -> ODTW\n","odtw_dict = dict(\n","    zip(\n","        df_odtw[\"Tahun\"],\n","        df_odtw[\"Jumlah Objek Daya Tarik Wisata (BPS)\"]\n","    )\n",")\n","\n","# ODTW mengikuti urutan tahun pada data NTL\n","odtw_observasi = [\n","    odtw_dict.get(tahun_i)\n","    for tahun_i in tahun\n","]\n","\n","# Data Frame\n","df = pd.DataFrame({\n","    \"tahun\": tahun,\n","    \"ntl\": ntl,\n","    \"odtw\": odtw_observasi\n","})\n","\n","# Data ODTW\n","obs = df.dropna(\n","    subset=[\"odtw\"]\n",").reset_index(drop=True)\n","\n","# Cek Data\n","print(\"=\" * 74)\n","print(\"DATA MASUKAN\")\n","print(\"=\" * 74)\n","\n","print(df.to_string(index=False))\n","\n","print(\n","    f\"\\nTitik observasi ODTW: \"\n","    f\"{len(obs)} tahun -> \"\n","    f\"{obs['tahun'].tolist()}\"\n",")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Iu8AFutI3Unv","executionInfo":{"status":"ok","timestamp":1789220994918,"user_tz":-420,"elapsed":5972,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"a68bdff2-67e8-464b-afcb-0d5adbc6308f"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["==========================================================================\n","DATA MASUKAN\n","==========================================================================\n"," tahun      ntl  odtw\n","2015.0 1.261585   NaN\n","2016.0 1.054415   NaN\n","2017.0 1.438316   NaN\n","2018.0 1.668258 177.0\n","2019.0 2.004828 189.0\n","2020.0 1.827902 180.0\n","2021.0 1.540893 170.0\n","2022.0 1.483312 183.0\n","2023.0 2.512341 201.0\n","2024.0 2.457036 218.0\n","2025.0 2.287813   NaN\n","\n","Titik observasi ODTW: 7 tahun -> [2018.0, 2019.0, 2020.0, 2021.0, 2022.0, 2023.0, 2024.0]\n"]}]},{"cell_type":"markdown","source":["2. MELATIH MODEL PADA SELURUH TITIK OBSERVASI (2018-2024)"],"metadata":{"id":"PR3Kf4rt4lMK"}},{"cell_type":"code","source":["b, a = np.polyfit(obs[\"ntl\"], obs[\"odtw\"], 1)\n","r, p_val = stats.pearsonr(obs[\"ntl\"], obs[\"odtw\"])\n","\n","print(\"=\" * 70)\n","print(\"MODEL REGRESI (dilatih pada observasi 2018-2024, n=7)\")\n","print(\"=\" * 70)\n","print(f\"  ODTW = {a:.2f} + {b:.2f} x NTL\")\n","print(f\"  R2 (level) = {r**2:.3f}\")\n","\n","# selang prediksi 95% untuk estimasi individual (bukan sekadar IK rata-rata)\n","n = len(obs)\n","x_bar = obs[\"ntl\"].mean()\n","Sxx = ((obs[\"ntl\"] - x_bar) ** 2).sum()\n","resid = obs[\"odtw\"] - (a + b * obs[\"ntl\"])\n","s_resid = np.sqrt((resid ** 2).sum() / (n - 2))\n","t_krit = stats.t.ppf(0.975, n - 2)\n","\n","def selang_prediksi(x0):\n","    \"\"\"Selang prediksi 95% untuk satu nilai NTL baru x0.\"\"\"\n","    pred = a + b * x0\n","    se_pred = s_resid * np.sqrt(1 + 1/n + (x0 - x_bar)**2 / Sxx)\n","    return pred, pred - t_krit*se_pred, pred + t_krit*se_pred"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5JRPkdO64eXb","executionInfo":{"status":"ok","timestamp":1789221044937,"user_tz":-420,"elapsed":65,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"3e9bdefc-32f0-40ff-d04e-02dd79f34491"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","MODEL REGRESI (dilatih pada observasi 2018-2024, n=7)\n","======================================================================\n","  ODTW = 121.61 + 34.59 x NTL\n","  R2 (level) = 0.785\n"]}]},{"cell_type":"markdown","source":[" 3. ESTIMASI TAHUN YANG BOLONG"],"metadata":{"id":"oZsC4gHc4qUn"}},{"cell_type":"code","source":["tahun_estimasi = [2015, 2016, 2017, 2025]\n","\n","print()\n","print(\"=\" * 70)\n","print(\"ESTIMASI 