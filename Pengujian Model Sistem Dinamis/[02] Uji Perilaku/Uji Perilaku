6)\n","print(\"\\n=== KESTABILAN ASUMSI PARAMETER ===\")\n","print(kestabilan.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zvkEE1f4bAx7","executionInfo":{"status":"ok","timestamp":1789990455028,"user_tz":-420,"elapsed":2568,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"0099bb6b-7a83-4e35-fcaf-91dc12cba7e4"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","=== KESTABILAN ASUMSI PARAMETER ===\n","                     Parameter                  Periode  n  Nilai di model  Rata-rata data  Minimum  Maksimum       CV  Selisih model vs rata-rata Asumsi konstan\n","  Rata-rata lama menginap tamu 2019–2025 (pascapatahan)  7         1.42700        1.471429 1.410000  1.590000 0.036585                   -0.030194         Stabil\n","  Rata-rata lama menginap tamu 2015–2025 (seluruh data) 11         1.42700        1.477273 1.380000  1.590000 0.049667                   -0.034031         Stabil\n","Tingkat Penghunian Ganda Kamar 2019–2025 (pascapatahan)  7         2.07000        2.075714 2.020000  2.150000 0.018364                   -0.002753         Stabil\n","Tingkat Penghunian Ganda Kamar 2015–2025 (seluruh data) 11         2.07000        2.040909 1.910000  2.150000 0.035546                    0.014254         Stabil\n","     Pengeluaran per Kunjungan 2019–2025 (pascapatahan)  7         0.00272        0.002060 0.001246  0.002720 0.279281                    0.320355   Tidak stabil\n","     Pengeluaran per Kunjungan 2015–2025 (seluruh data) 11         0.00272        0.001745 0.001024  0.002720 0.358440                    0.559159   Tidak stabil\n","   Proporsi Wisatawan Menginap 2019–2025 (pascapatahan)  7         0.20580        0.247120 0.163715  0.438894 0.337101                   -0.167207   Tidak stabil\n","   Proporsi Wisatawan Menginap 2015–2025 (seluruh data) 11         0.20580        0.443898 0.163715  1.031680 0.641358                   -0.536380   Tidak stabil\n"]}]},{"cell_type":"markdown","source":["7. Simpan tabel dan grafik"],"metadata":{"id":"CzTKtMhi65O7"}},{"cell_type":"code","source":["FOLDER_OUT = Path(\"/content/drive/MyDrive/Skripsi_Citra/Pengujian Model Sistem Dinamis/[02] Uji Perilaku\")\n","FOLDER_OUT.mkdir(exist_ok=True)\n","\n","berkas = FOLDER_OUT / \"hasil_uji_perilaku.xlsx\"\n","with pd.ExcelWriter(berkas) as writer:\n","    hasil.to_excel(writer, sheet_name=\"Statistik\", index=False)\n","    kestabilan.to_excel(writer, sheet_name=\"Kestabilan Parameter\", index=False)\n","    pd.DataFrame({\"Data asli\": jw, \"Data sambungan\": jw_sambung,\n","                  \"Faktor\": faktor}).to_excel(writer, sheet_name=\"Seri Wisatawan\")\n","    for label, r in hasil_parsial.items():\n","        r.round(4).to_excel(writer, sheet_name=label[:31])\n","    r_penuh.round(4).to_excel(writer, sheet_name=\"B Uji penuh\")\n","    pd.DataFrame({k.strip('\"'): v for k, v in DATA_UJI.items()}).to_excel(writer, sheet_name=\"Data Pembanding\")\n","\n","def grafik(sim, obs, judul, nama):\n","    idx = [t for t in obs.dropna().index if t in sim.index]\n","    fig, ax = plt.subplots(figsize=(6.5, 4))\n","    ax.plot(idx, obs.loc[idx], \"o-\", label=\"Data\", lw=2)\n","    ax.plot(idx, sim.loc[idx], \"s--\", label=\"Simulasi\", lw=2)\n","    for t in TAHUN_COVID:\n","        if t in idx:\n","            ax.axvspan(t - 0.4, t + 0.4, color=\"grey\", alpha=0.15)\n","    ax.set_title(judul, fontsize=10); ax.set_xlabel(\"Tahun\")\n","    ax.grid(alpha=0.3); ax.legend(fontsize=8)\n","    fig.tight_layout(); fig.savefig(FOLDER_OUT / f\"{nama}.png\", dpi=150); plt.close(fig)\n","\n","for label, (masukan, dinilai) in UJI_PARSIAL.items():\n","    for v in dinilai:\n","        grafik(hasil_parsial[label][v], DATA_UJI[v], f\"{label} — {v.strip(chr(34))}\",\n","               f\"{label.split()[0]}_{v.strip(chr(34))[:20].replace('/','-')}\")\n","for v in KELUARAN:\n","    if v in DATA_UJI:\n","        grafik(r_penuh[v], DATA_UJI[v], f\"Uji penuh 2019–2025 — {v.strip(chr(34))}\",\n","               f\"B_{v.strip(chr(34))[:20].replace('/','-')}\")\n","\n","print(f\"\\nTabel tersimpan : {berkas}\")\n","print(f\"Grafik tersimpan: folder '{FOLDER_OUT}'\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HHrFPqRb67VL","executionInfo":{"status":"ok","timestamp":1789990464438,"user_tz":-420,"elapsed":4156,"user":{"displayName":"Kevin Atha Fathoni Ramadha","userId":"09413341038730317114"}},"outputId":"283a5819-330e-4280-d21d-4a49a29f501c"},"execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Tabel tersimpan : /content/drive/MyDrive/Skripsi_Citra/Pengujian Model Sistem Dinamis/[02] Uji Perilaku/hasil_uji_perilaku.xlsx\n","Grafik tersimpan: folder '/content/drive/MyDrive/Skripsi_Citra/Pengujian Model Sistem Dinamis/[02] Uji Perilaku'\n"]}]}]}